<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.gradapps.notify-opens</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>PROJECT_ROOT/scripts/notify_application_opens.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>PROJECT_ROOT</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>PROJECT_ROOT/_shared/.notify-launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>PROJECT_ROOT/_shared/.notify-launchd.err.log</string>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
